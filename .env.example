# Copy this file to ".env" and fill in ONE key. Never commit your real .env file.
# Free keys: https://console.groq.com/keys  or  https://aistudio.google.com/apikey

GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: force a provider (groq | gemini | openai | anthropic | ollama) and/or a model name
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: use already-downloaded datasets instead of kagglehub
# GARBAGE_DATA_DIR=C:/data/garbage-classification
# BBC_DATA_DIR=C:/data/bbc
# TMDB_DATA_DIR=C:/data/tmdb
